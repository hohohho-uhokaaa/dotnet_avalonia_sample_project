<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- GUIアプリとしてビルドし、Fedora 44環境の.NET 10をターゲットにします。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- null許容参照型のチェックを有効にして、null関連の誤りを検出しやすくします。 -->
    <Nullable>enable</Nullable>
    <!-- アプリのマニフェストとAvaloniaのXAMLバインディング設定です。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- UIフレームワーク本体、デスクトップ実行機能、Fluentテーマ、Interフォントです。 -->
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <!-- 診断ツールはDebugビルドで使い、Release出力には含めません。 -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.9">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia.Desktopが必要とするD-Bus実装。0.21.3は脆弱性修正版です。 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>
