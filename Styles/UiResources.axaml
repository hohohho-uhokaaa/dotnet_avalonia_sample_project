<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ウィンドウの初期サイズと、ユーザーが縮小できる最小サイズです（Avaloniaの論理ピクセル）。 -->
    <x:Double x:Key="WindowWidth">260</x:Double>
    <x:Double x:Key="WindowHeight">132</x:Double>
    <x:Double x:Key="MinimumWindowWidth">240</x:Double>
    <x:Double x:Key="MinimumWindowHeight">132</x:Double>

    <!-- 画面全体、カード、アイコン、文字、入力欄、ボタンに使う色です。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />

    <!-- ウィンドウ内側と各コントロール間の余白をまとめています（左・上・右・下）。 -->
    <Thickness x:Key="WindowContentMargin">6</Thickness>
    <Thickness x:Key="CardPadding">8</Thickness>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="InputPadding">6,3</Thickness>
    <Thickness x:Key="ButtonPadding">6,2</Thickness>

    <!-- カードとアイコン背景の角丸半径です。 -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="IconCornerRadius">6</CornerRadius>

    <!-- StackPanelの間隔、アイコン寸法、文字サイズ、入力欄とボタンの高さです。 -->
    <x:Double x:Key="ContentSpacing">6</x:Double>
    <x:Double x:Key="HeaderSpacing">6</x:Double>
    <x:Double x:Key="IconSize">20</x:Double>
    <x:Double x:Key="CompactFontSize">10</x:Double>
    <x:Double x:Key="InputHeight">26</x:Double>
    <x:Double x:Key="ButtonHeight">26</x:Double>
</ResourceDictionary>
